{
  "version": "0.1-development",
  "scope": "PNW selected-event offline triage, not continuous-stream false-alarm evaluation",
  "target": "earthquake",
  "non_target_classes": [
    "explosion",
    "sonic_boom",
    "surface_event",
    "thunder"
  ],
  "seed": 20261002,
  "split_unit": "event_id",
  "split_fractions": {
    "train": 0.6,
    "calibration": 0.2,
    "test": 0.2
  },
  "representative_trace": "lexicographic network/station/channel then row_id, without label-based SNR selection",
  "observation_seconds": 120,
  "initial_evidence": [
    "quality",
    "amplitude_envelope_summary"
  ],
  "additional_evidence": [
    "spectral_summary",
    "component_summary",
    "other_station_if_available"
  ],
  "max_additional_calls": 3,
  "exploratory_calibration_limits": {
    "earthquake_discard_rate": 0.02,
    "non_target_accept_rate": 0.05,
    "auto_error_rate": 0.05
  },
  "threshold_selection": "calibration only; report test error even if constraint is not met",
  "model_call_budget": {
    "deepseek": {
      "currency": "CNY",
      "total_limit": 20,
      "scope": "current validation round",
      "user_authorized": true
    },
    "agnes": {
      "quota": "unknown",
      "unlimited": false
    }
  },
  "final_model_test_enabled": false,
  "forbidden_inputs": [
    "source_type",
    "source_type_pnsn_label",
    "event_id",
    "catalog_magnitude",
    "catalog_depth",
    "expert_picks",
    "catalog_SNR",
    "source_filename",
    "record_length",
    "final_catalog_lookup"
  ],
  "limitations": [
    "historically curated event windows",
    "mostly single-station cases",
    "not a representative automatic trigger queue",
    "no direct operational workload claim",
    "timestamp reconciliation is metadata-only, not physical timing validation"
  ]
}
